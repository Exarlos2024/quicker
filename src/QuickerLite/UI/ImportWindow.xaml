<Window x:Class="QuickerLite.UI.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:QuickerLite.UI"
        Title="从开始菜单批量导入"
        Width="620"
        Height="600"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Background="{StaticResource PanelBrush}"
        UseLayoutRounding="True">

    <Grid Margin="20,18,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText"
                   Grid.Row="0"
                   Text="正在扫描开始菜单和桌面…"
                   FontSize="{x:Static ui:Metrics.FontBody}"
                   LineHeight="20"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" />

        <!-- 过滤框。和主面板的命令栏同一套外观 -->
        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Style="{StaticResource CommandBarStyle}"
                Height="{x:Static ui:Metrics.InputHeight}">
            <Grid Margin="12,0,12,0">
                <TextBlock x:Name="SearchPlaceholder"
                           Text="过滤（支持子序列，如 sm 命中「扫描」）"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           FontSize="{x:Static ui:Metrics.FontBody}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource SearchTextBoxStyle}"
                         TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SelectAllButton"
                        Style="{StaticResource FlatButtonStyle}"
                        Foreground="{StaticResource Accent700Brush}"
                        Content="全选当前显示"
                        Click="OnSelectAllClick" />
                <Button x:Name="SelectNoneButton"
                        Style="{StaticResource FlatButtonStyle}"
                        Foreground="{StaticResource Accent700Brush}"
                        Content="全不选"
                        Margin="4,0,0,0"
                        Click="OnSelectNoneClick" />
                <Button x:Name="InvertButton"
                        Style="{StaticResource FlatButtonStyle}"
                        Foreground="{StaticResource Accent700Brush}"
                        Content="反选"
                        Margin="4,0,0,0"
                        Click="OnInvertClick" />
            </StackPanel>
            <TextBlock x:Name="CountText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="{x:Static ui:Metrics.FontLabel}"
                       Foreground="{StaticResource TextTertiaryBrush}" />
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ListBox x:Name="CandidateList"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{x:Static ui:Metrics.FontBody}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="{x:Static ui:Metrics.FontLabel}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="TargetText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="{x:Static ui:Metrics.FontLabel}"
                       Foreground="{StaticResource TextTertiaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="取消"
                        MinWidth="86"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />
                <Button x:Name="ImportButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="导入"
                        MinWidth="126"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OnImportClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
